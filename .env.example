# branchDAM secrets — example. Copy to .env and fill in.
#   cp .env.example .env
#
# .env is gitignored. Values here are referenced from config.yaml via ${VAR}
# (see config.example.yaml) and read directly by compose.yaml/compose-dev.yaml.

# Machine-principal key for /api/v1/agent/* routes (internal/auth), which
# bypass Authentik ForwardAuth at the Traefik layer -- see docs/forward-auth.md.
# Must be at least 32 characters or agent routes fail closed with 503.
# Generate one with: openssl rand -hex 32
BRANCHDAM_AGENT_API_KEY=

# Encrypts UI-configured secrets (e.g. immich.apiKey) stored in
# app_settings (internal/secrets, internal/settings) -- see
# docs/configuration.md's precedence section. Optional: leave unset and
# those settings fields are simply unavailable in the UI until this is set;
# the server still starts normally. If set, it must be valid base64-encoded
# 32 bytes or the server refuses to start.
# Generate one with: openssl rand -base64 32
BRANCHDAM_SECRET_KEY=
