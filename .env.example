# branchDAM secrets — example. Copy to .env and fill in.
#   cp .env.example .env
#
# .env is gitignored. Values here are referenced from config.yaml via ${VAR}
# (see config.example.yaml) and read directly by compose.yaml/compose-dev.yaml.

# Machine-principal key for /api/v1/agent/* routes (internal/auth), which
# bypass Authentik ForwardAuth at the Traefik layer -- see docs/forward-auth.md.
# Must be at least 32 characters or agent routes fail closed with 503.
# Generate one with: openssl rand -hex 32
BRANCHDAM_AGENT_API_KEY=
